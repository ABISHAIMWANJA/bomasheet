{
  "name": "@teable/telegram-bot",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "description": "BomaClaw: a Telegram bot that lets a user query and edit their own BomaSheet data via chat, using their personal access token and an LLM with tool-calling over BomaSheet's REST API.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "telegraf": "^4.16.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "5.4.2",
    "vitest": "^1.5.0"
  }
}
