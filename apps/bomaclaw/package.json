{
  "name": "@teable/bomaclaw",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "description": "BomaClaw: chat with your BomaSheet data from Telegram or WhatsApp (Meta Cloud API or Twilio), using your personal access token and an LLM with tool-calling over BomaSheet's REST API.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "telegraf": "^4.16.3",
    "zod": "^3.22.4",
    "express": "^4.19.2",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "5.4.2",
    "vitest": "^1.5.0",
    "@types/express": "^4.17.21"
  }
}
